[Unit]
Description=Nightly Whosdaleader browser restart
After=whodaleader.service

[Service]
Type=oneshot
User=pi
# Kill Chromium; the autostart file brings it back within seconds.
# DISPLAY/WAYLAND_DISPLAY set so the kill works from a non-login shell.
ExecStart=/bin/bash -c 'pkill -f "chromium.*kiosk" || true'
